{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ECSRunTaskMigration",
      "Effect": "Allow",
      "Action": ["ecs:RunTask", "ecs:DescribeTasks", "ecs:DescribeTaskDefinition"],
      "Resource": "*"
    },
    {
      "Sid": "PassRoleForECSTasks",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::ACCOUNT_ID:role/REPLACE_WITH_ECS_TASK_EXECUTION_ROLE_NAME",
        "arn:aws:iam::ACCOUNT_ID:role/REPLACE_WITH_ECS_TASK_ROLE_NAME"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    }
  ]
}
