# Puerto del API
PORT=3000

# JWT (usa un valor largo y aleatorio en producción)
JWT_SECRET=cambia-esto-en-produccion
JWT_EXPIRES_IN=8h

# CORS: el origen permitido está fijado en src/app.ts (solo AWS Amplify).

# PostgreSQL (login): DATABASE_URL o DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD (+ PGSSLMODE=require en RDS)
# En ECS, mismas claves que inyecta Secrets Manager en la task definition.

# DEBUG_LOGIN=1  # Log en POST /auth/login: body JSON con password enmascarado (quitar tras depurar)
