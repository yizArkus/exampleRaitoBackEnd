# Puerto del API
PORT=3000

# JWT (usa un valor largo y aleatorio en producción)
JWT_SECRET=cambia-esto-en-produccion
JWT_EXPIRES_IN=8h

# Orígenes del front permitidos por CORS (separados por coma, sin espacios extra alrededor de la coma o tras trim)
# Ejemplos: Vite http://localhost:5173 | Next http://localhost:3000 (si el front no usa el mismo puerto que el API)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
