# Server
PORT=3000

# JWT — use a long random secret in production
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# CORS — comma-separated browser origins (trailing slashes optional; normalized at runtime).
# Prefer ALLOWED_ORIGINS; CORS_ORIGINS is accepted as an alias (e.g. JSON key in Secrets Manager).
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL — DATABASE_URL or discrete keys (ECS task / Secrets Manager)
# DATABASE_URL=postgres://...
# DB_HOST= DB_PORT=5432 DB_NAME= DB_USER= DB_PASSWORD=
# PGSSLMODE=require

# DEBUG_LOGIN=1
